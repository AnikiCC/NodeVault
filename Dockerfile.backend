FROM golang:1.24-alpine AS backend-builder

RUN apk add --no-cache gcc musl-dev linux-headers git

WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./

RUN CGO_ENABLED=1 go build -o /nodevault-backend ./cmd

FROM alpine:latest

RUN apk add --no-cache libstdc++

WORKDIR /app

COPY --from=backend-builder /nodevault-backend .

RUN mkdir -p /app/data

EXPOSE 8080

CMD ["./nodevault-backend"]